{
  "name": "cutova",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.edge.json && vite build && node seo/build.mjs && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run --reporter=dot",
    "test:e2e": "playwright test",
    "test:e2e:remote": "playwright test -c playwright.remote.config.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dev:edge": "wrangler d1 migrations apply cutova-stats --local && wrangler pages dev dist --port 8788",
    "check:audit": "npm audit --audit-level=high",
    "screenshots": "node tests/screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  }
}
